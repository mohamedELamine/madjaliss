{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"color": {
			"custom": true,
			"customDuotone": true,
			"customGradient": true,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"name": "اللون الأساسي",
					"slug": "primary",
					"color": "#339063"
				},
				{
					"name": "اللون الأساسي الفاتح",
					"slug": "primary-light",
					"color": "#4db080"
				},
				{
					"name": "اللون الأساسي الغامق",
					"slug": "primary-dark",
					"color": "#267a4f"
				},
				{
					"name": "لون الأكسنت",
					"slug": "accent",
					"color": "#6FAF8D"
				},
				{
					"name": "النص الأساسي",
					"slug": "text-primary",
					"color": "#2c3e50"
				},
				{
					"name": "النص الثانوي",
					"slug": "text-secondary",
					"color": "#5a6c7d"
				},
				{
					"name": "النص الفاتح",
					"slug": "text-light",
					"color": "#8899a6"
				},
				{
					"name": "الخلفية الفاتحة",
					"slug": "bg-light",
					"color": "#fafafa"
				},
				{
					"name": "الخلفية الأفتح",
					"slug": "bg-lighter",
					"color": "#ffffff"
				},
				{
					"name": "الحدود",
					"slug": "border",
					"color": "#e1e8ed"
				}
			]
		},
		"typography": {
			"customFontSize": true,
			"fontStyle": true,
			"fontWeight": true,
			"letterSpacing": true,
			"lineHeight": true,
			"textDecoration": true,
			"textTransform": true,
			"dropCap": false,
			"fontFamilies": [
				{
					"fontFamily": "\"Cairo\", \"Tajawal\", -apple-system, BlinkMacSystemFont, sans-serif",
					"name": "Cairo",
					"slug": "cairo"
				}
			],
			"fontSizes": [
				{
					"name": "صغير جداً",
					"size": "14px",
					"slug": "x-small"
				},
				{
					"name": "صغير",
					"size": "16px",
					"slug": "small"
				},
				{
					"name": "متوسط",
					"size": "18px",
					"slug": "medium"
				},
				{
					"name": "كبير",
					"size": "20px",
					"slug": "large"
				},
				{
					"name": "كبير جداً",
					"size": "24px",
					"slug": "x-large"
				},
				{
					"name": "ضخم",
					"size": "32px",
					"slug": "xx-large"
				},
				{
					"name": "عملاق",
					"size": "40px",
					"slug": "xxx-large"
				}
			]
		},
		"spacing": {
			"blockGap": true,
			"margin": true,
			"padding": true,
			"units": ["px", "em", "rem", "vh", "vw", "%"],
			"spacingScale": {
				"steps": 0
			},
			"spacingSizes": [
				{
					"name": "صغير جداً",
					"size": "8px",
					"slug": "xs"
				},
				{
					"name": "صغير",
					"size": "16px",
					"slug": "sm"
				},
				{
					"name": "متوسط",
					"size": "24px",
					"slug": "md"
				},
				{
					"name": "كبير",
					"size": "48px",
					"slug": "lg"
				},
				{
					"name": "كبير جداً",
					"size": "64px",
					"slug": "xl"
				},
				{
					"name": "ضخم",
					"size": "96px",
					"slug": "xxl"
				}
			]
		},
		"layout": {
			"contentSize": "800px",
			"wideSize": "1200px"
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"custom": {
			"spacing": {
				"xs": "8px",
				"sm": "16px",
				"md": "24px",
				"lg": "48px",
				"xl": "64px",
				"xxl": "96px"
			},
			"radius": {
				"sm": "6px",
				"md": "12px",
				"lg": "16px"
			},
			"shadow": {
				"soft": "0 2px 12px rgba(0, 0, 0, 0.04)",
				"medium": "0 4px 20px rgba(0, 0, 0, 0.08)",
				"hover": "0 8px 30px rgba(51, 144, 99, 0.12)",
				"accent": "0 10px 30px rgba(77, 176, 128, 0.18)"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--bg-light)",
			"text": "var(--wp--preset--color--text-primary)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--cairo)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.8"
		},
		"spacing": {
			"blockGap": "var(--wp--custom--spacing--md)"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--primary-dark)"
					}
				},
				":focus": {
					"color": {
						"text": "var(--wp--preset--color--primary-dark)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "#ffffff"
				},
				"border": {
					"radius": "var(--wp--custom--radius--md)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "600"
				},
				"spacing": {
					"padding": {
						"top": "12px",
						"right": "32px",
						"bottom": "12px",
						"left": "32px"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary-dark)"
					}
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xxx-large)",
					"fontWeight": "700",
					"lineHeight": "1.4"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"fontWeight": "700",
					"lineHeight": "1.4"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontWeight": "700",
					"lineHeight": "1.4"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "600",
					"lineHeight": "1.4"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "600",
					"lineHeight": "1.4"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "600",
					"lineHeight": "1.4"
				}
			}
		},
		"blocks": {
			"core/paragraph": {
				"spacing": {
					"margin": {
						"bottom": "var(--wp--custom--spacing--md)"
					}
				}
			},
			"core/heading": {
				"spacing": {
					"margin": {
						"bottom": "var(--wp--custom--spacing--md)"
					}
				}
			},
			"core/button": {
				"border": {
					"radius": "var(--wp--custom--radius--md)"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "الترويسة",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "التذييل",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "blank",
			"title": "صفحة فارغة",
			"postTypes": ["page"]
		}
	]
}
